@startuml
skinparam linetype ortho
skinparam monochrome true
title Состояние календарного дня мастера WorkDay
[*] --> UNSET : дата ещё не заполнена
UNSET --> WORKING : setHours(10..20)
UNSET --> DAY_OFF : setDayOff()
WORKING --> DAY_OFF : setDayOff() [нет будущих записей]
DAY_OFF --> WORKING : setHours(10..20)
WORKING --> WORKING : changeHours() [нет конфликтов с записями]
WORKING --> PAST : when(now >= date + 1d)
DAY_OFF --> PAST : when(now >= date + 1d)
PAST --> [*]
@enduml
