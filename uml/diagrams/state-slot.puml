@startuml
skinparam linetype ortho
skinparam monochrome true
title Доступность часового слота мастера
[*] --> UNDEFINED : дата без WorkDay
UNDEFINED --> DAY_OFF : setDayOff()
UNDEFINED --> FREE : setWorkHours() [час в интервале]
DAY_OFF --> FREE : setWorkHours() [час в интервале]
FREE --> BOOKED : book() [нет блока]
FREE --> BLOCKED : block(reason) [нет записи]
BLOCKED --> FREE : unblock() [час будущий]
BOOKED --> FREE : cancel() [до начала]
FREE --> PAST : when(now >= hour)
BLOCKED --> PAST : when(now >= hour)
BOOKED --> COMPLETED : when(now >= hour + 1h)
PAST --> [*]
COMPLETED --> [*]
@enduml
