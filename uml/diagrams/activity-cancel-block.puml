@startuml
skinparam monochrome true
title Отмена записи и блокировка часа
start
if (Действие?) then (Отменить запись)
 :Выбрать предстоящую запись;
 if (Запись доступна актёру и ещё не началась?) then (да)
  :Booking → CANCELLED;
  :Освободить час;
 else (нет)
  :Показать отказ;
 endif
else (Блокировать час)
 :Выбрать час и указать причину;
 :Начать транзакцию и заблокировать рабочий день;
 if (Час рабочий, свободный и будущий?) then (да)
  :Создать SlotBlock;
  :Зафиксировать транзакцию;
 else (нет)
  :Откатить транзакцию;
  :Показать конфликт;
 endif
endif
stop
@enduml
